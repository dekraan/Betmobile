# --- Bevroren modeldefinities WEL meenemen ---
# Deze bestanden bepalen welke tier/calibratie een pick kreeg. Zonder hen is
# tier_version / calibration_version in de database niet meer te herleiden.
output/
!eci_engine/output/
!eci_engine/output/calibration/
!eci_engine/output/research/
eci_engine/output/**/*.xlsx
!eci_engine/output/calibration/tier_definition.json
!eci_engine/output/calibration/calibration_weights.json
!eci_engine/output/research/strong_segments.json
!eci_engine/output/research/danger_segments.json
eci_engine/output/**/*.csv